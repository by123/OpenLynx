# Required: get one at https://www.voyageai.com/
VOYAGE_API_KEY=

# Optional: how many top matches the on_prompt hook injects
TOP_K=5

# Optional: minimum cosine similarity (0–1) for a match to be injected
MIN_SCORE=0.3

# Optional: override the data directory (default: ~/.claude/claude-memory)
# CLAUDE_MEMORY_DIR=

# Optional: model used for end-of-session summaries
# CLAUDE_MEMORY_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Optional: goal-based gating. When a goal is set (lynx-memory goal set ...),
# an LLM decides whether each turn is relevant to the goal before storing it.
# GOAL_GATING_ENABLED=1            # set 0 to keep storing every turn even with a goal
# GOAL_STRICTNESS=strict           # loose | balanced | strict
# GOAL_JUDGE_TIMEOUT=8             # seconds for the relevance LLM call (0 = no timeout)
